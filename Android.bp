package {
    default_applicable_licenses: ["external_python_pexpect_license"],
}

license {
    name: "external_python_pexpect_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "ISC",
    ],
    license_text: [
        "LICENSE",
    ],
}

python_library_host {
    name: "pexpect",
    srcs: ["pexpect/*.py"],
}
